LOCATE COMP "clk" SITE "M1";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 50 MHZ;

LOCATE COMP "button[0]" SITE "C4";
IOBUF PORT "button[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "led[0]" SITE "E13";
LOCATE COMP "led[1]" SITE "D14";
LOCATE COMP "led[2]" SITE "E12";
LOCATE COMP "led[3]" SITE "C13";
LOCATE COMP "led[4]" SITE "D13";

IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "button[1]" SITE "C5";
IOBUF PORT "button[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "usb_rx" SITE "K16";
IOBUF PORT "usb_rx" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "usb_tx" SITE "K15";
IOBUF PORT "usb_tx" IO_TYPE=LVCMOS33 DRIVE=4;
