# Read the four RF entries as individual wires so A, B, C and D are tappable.
read_verilog -sv -mem2reg src/register_file.v
read_verilog -sv -DICEPI_ZERO src/prometheus_lite.v src/control_unit.v src/instruction_register.v src/program_counter.v src/memory.v src/project.v
read_verilog fpga/icepi-zero/top.v fpga/icepi-zero/trace.v fpga/icepi-zero/uart_bridge.v
hierarchy -top top
proc
flatten
cd top
connect -nomap -nounset -set pc project.cpu.value_pc
connect -nomap -nounset -set sp project.cpu.stack_pointer
connect -nomap -nounset -set state project.cpu.state
connect -nomap -nounset -set opcode project.cpu.opcode
connect -nomap -nounset -set register_a project.cpu.rf.registers[0]
connect -nomap -nounset -set register_b project.cpu.rf.registers[1]
connect -nomap -nounset -set register_c project.cpu.rf.registers[2]
connect -nomap -nounset -set register_d project.cpu.rf.registers[3]
connect -nomap -nounset -set zero project.cpu.zero
connect -nomap -nounset -set memory_address project.memory_address
connect -nomap -nounset -set memory_read_enable project.memory_read_enable
connect -nomap -nounset -set memory_write_enable project.memory_write_enable
connect -nomap -nounset -set memory_write_data project.memory_write_data
connect -nomap -nounset -set memory_read_data project.memory_read_data
cd ..
synth_ecp5 -top top -json build/icepi/cpu.json
